{
    "manifest_version": 3,
    "name": "Proxy extension",
    "description": "Add your favorite proxy-server for necessary sites!",
    "version": "1.0.0",
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "permissions": [
        "activeTab",
        "storage",
        "proxy",
        "webRequest",
        "webRequestAuthProvider"
    ],
    "host_permissions": ["<all_urls>"],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
